{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/agent_output.schema.json",
  "title": "AgentOutputEnvelope",
  "type": "object",
  "required": [
    "request_id",
    "agent_name",
    "status",
    "output",
    "created_at"
  ],
  "properties": {
    "request_id": {
      "type": "string"
    },
    "agent_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "revise",
        "escalate",
        "failed"
      ]
    },
    "output": {
      "type": "object"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}